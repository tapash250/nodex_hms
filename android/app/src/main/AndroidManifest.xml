<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NODEX Enterprise HMS - Android manifest.

      Permissions are declared narrowly and justified individually. A clinical
      application that over-requests permissions is harder to approve in a
      hospital security review, and every permission here maps to a specific
      specification requirement.
    -->

    <!-- Replication to the authoritative cloud system of record. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Connectivity state drives the offline authorization policy: privileged
      actions are refused while offline, so the app must be able to tell.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Biometric session unlock (module 52). USE_BIOMETRIC covers API 28+;
      USE_FINGERPRINT is retained for older ward devices still in service.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />

    <!--
      Background synchronization via WorkManager needs to survive device idle so
      that queued clinical mutations reach the server after a ward round.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Non-life-critical notifications only; critical alerts use a dedicated path. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Hardware features are optional so the same build installs on ward tablets
      without a camera or fingerprint sensor.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="NODEX HMS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="33">

        <!--
          allowBackup is disabled: an Android backup of the encrypted database
          without its Keystore-held key is useless, and a backup that captured
          clinical data would create an uncontrolled copy outside the retention
          policy. Client devices are never the authoritative backup mechanism.
        -->
        <meta-data
            android:name="android.app.allowBackup"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true">

            <!-- Theme applied while the Flutter UI initialises. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Required for the Flutter engine's text processing plugin.
      See https://developer.android.com/training/package-visibility
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
