# PowerSync Cloud deployment environment.
#
# Copy to .env and fill in the values. .env is untracked; never commit it.
# The PowerSync CLI reads these from the process environment, so load the file
# before running CLI commands:
#
#   set -a; . powersync/.env; set +a

# Source database connection. Must use the dedicated powersync_role and must
# not contain the password.
PS_DATABASE_URI=postgresql://powersync_role@db.neoernavfntxsotwvmwq.supabase.co:5432/postgres

# Password for powersync_role. Generate with: openssl rand -base64 32
POWERSYNC_DATABASE_PASSWORD=<powersync_role-password>

# PowerSync Cloud personal access token, used when you do not run
# `powersync login`. Create it in the PowerSync dashboard.
PS_ADMIN_TOKEN=<powersync-cloud-token>

# Client build define. Not a secret.
# NODEX_POWERSYNC_URL=https://6ae4764ab0047aeb6df81fd9.powersync.journeyapps.com
