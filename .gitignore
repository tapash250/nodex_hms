# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- NODEX additions -------------------------------------------------------

# Local Android SDK/Flutter paths, machine-specific.
/android/local.properties
/android/key.properties
/android/**/*.jks
/android/**/*.keystore

# Backend and provider configuration is supplied via --dart-define at build
# time and must never be committed.
.env
.env.*
!.env.example
*.secrets.json

# Generated code, regenerated by build_runner.
*.g.dart
*.freezed.dart

# Test and profiling output.
/coverage/
*.lcov
/test/**/failures/
